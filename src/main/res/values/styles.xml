        <item name="android:colorAccent">#e8b04f</item>
        <item name="android:windowBackground">#0d1117</item>
        <item name="android:colorBackground">#161b22</item>
        <item name="android:textColorPrimary">#c9d1d9</item>
        <item name="android:textColorSecondary">#8b949e</item>
        <item name="android:alertDialogTheme">@style/OverMeshDialog</item>
        <item name="android:windowLightStatusBar">false</item>
